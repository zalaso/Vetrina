---
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "@fontsource-variable/work-sans";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config/site.config";

interface Props {
  titolo?: string;
  descrizione?: string;
  /** URL immagine per Open Graph (assoluto o relativo al sito) */
  ogImage?: string;
  /** Pagina non ancora pronta: la si tiene fuori dai motori di ricerca */
  noindex?: boolean;
}

const {
  titolo,
  descrizione = siteConfig.descrizione,
  ogImage,
  noindex = false,
} = Astro.props;

const titoloCompleto = titolo
  ? `${titolo} · ${siteConfig.nomeAttivita}`
  : `${siteConfig.nomeAttivita} · Antiquariato`;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.nomeAttivita} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="it_IT" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
