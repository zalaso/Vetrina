---
/**
 * Il marchio disegnato con la tipografia del sito: monogramma grande in
 * serif con una parola spaziata sotto.
 *
 * Non è un'immagine: si ricava dal nome dell'attività, così ogni bottega ha
 * il proprio senza dover fornire un file. Vedi `logo` in site.config.ts.
 *
 * Per usare un logo vero, metti il file in `public/` e sostituisci il
 * contenuto di questo componente con un `<img>`.
 */
import { siteConfig } from "../config/site.config";

interface Props {
  /** Dimensione del monogramma, es. "1.9rem" (predefinita) o "2.6rem" */
  dimensione?: string;
}

const { dimensione = "1.9rem" } = Astro.props;
const { monogramma, parola } = siteConfig.logo;
---

<span class="logo" style={`--logo-dimensione: ${dimensione}`}>
  <span class="logo__monogramma" aria-hidden="true">{monogramma}</span>
  {parola && <span class="logo__parola" aria-hidden="true">{parola}</span>}
  <span class="visivamente-nascosto">{siteConfig.nomeAttivita}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    color: inherit;
  }

  .logo__monogramma {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--logo-dimensione);
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .logo__parola {
    font-family: var(--sans);
    font-weight: 400;
    font-size: calc(var(--logo-dimensione) * 0.26);
    letter-spacing: 0.52em;
    text-transform: uppercase;
    white-space: nowrap;
    margin-top: 0.35em;
    /* compensa lo spazio finale del letter-spacing, per centrare davvero */
    margin-right: -0.52em;
  }

  .visivamente-nascosto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
