---
import Base from "../../layouts/Base.astro";
import { getOggetti } from "../../lib/catalog";
import { formatPrezzo } from "../../lib/types";
import { siteConfig, whatsappLink } from "../../config/site.config";

export async function getStaticPaths() {
  const oggetti = await getOggetti();
  return oggetti.map((oggetto) => ({
    params: { id: oggetto.id },
    props: { oggetto },
  }));
}

const { oggetto } = Astro.props;

const caratteristiche = [
  { nome: "Epoca", valore: oggetto.epoca },
  { nome: "Materiale", valore: oggetto.materiale },
  { nome: "Dimensioni", valore: oggetto.dimensioni },
  { nome: "Categoria", valore: oggetto.categoria },
].filter((c) => c.valore);

const piuFoto = oggetto.foto.length > 1;
---

<Base
  titolo={oggetto.nome}
  descrizione={oggetto.descrizioneBreve}
  ogImage={oggetto.foto[0]}
>
  <section class="sezione">
    <div class="contenitore">
      <nav class="briciole" aria-label="Percorso">
        <a href="/catalogo/">← Torna al catalogo</a>
      </nav>

      <div class="dettaglio">
        <!-- Galleria -->
        <div class="galleria">
          <div class="galleria__cornice">
            {
              oggetto.foto.map((url, i) => (
                <img
                  class="galleria__foto"
                  src={url}
                  alt={`${oggetto.nome}, foto ${i + 1} di ${oggetto.foto.length}`}
                  width="1200"
                  height="1500"
                  loading={i === 0 ? "eager" : "lazy"}
                  data-indice={i}
                  hidden={i !== 0}
                />
              ))
            }
            {
              piuFoto && (
                <>
                  <button
                    class="galleria__freccia galleria__freccia--sinistra"
                    type="button"
                    aria-label="Foto precedente"
                    data-direzione="-1"
                  >
                    ‹
                  </button>
                  <button
                    class="galleria__freccia galleria__freccia--destra"
                    type="button"
                    aria-label="Foto successiva"
                    data-direzione="1"
                  >
                    ›
                  </button>
                </>
              )
            }
          </div>
          {
            piuFoto && (
              <div class="galleria__punti" role="tablist" aria-label="Scegli la foto">
                {oggetto.foto.map((_, i) => (
                  <button
                    class:list={["galleria__punto", { attivo: i === 0 }]}
                    type="button"
                    aria-label={`Vai alla foto ${i + 1}`}
                    data-vai={i}
                  />
                ))}
              </div>
            )
          }
        </div>

        <!-- Testo -->
        <div class="dettaglio__testo">
          <h1 class="dettaglio__titolo">{oggetto.nome}</h1>
          {oggetto.epoca && <p class="dettaglio__epoca">{oggetto.epoca}</p>}
          <p class="dettaglio__prezzo">
            {oggetto.stato === "Venduto" ? "Venduto" : formatPrezzo(oggetto.prezzo)}
          </p>

          <p class="dettaglio__descrizione">{oggetto.descrizioneLunga}</p>

          {
            caratteristiche.length > 0 && (
              <dl class="caratteristiche">
                {caratteristiche.map((c) => (
                  <div class="caratteristiche__voce">
                    <dt>{c.nome}</dt>
                    <dd>{c.valore}</dd>
                  </div>
                ))}
              </dl>
            )
          }

          {
            oggetto.stato !== "Venduto" ? (
              <div class="contatto">
                <p class="contatto__titolo">Ti interessa questo pezzo?</p>
                <p class="contatto__testo">
                  Scrivici o chiamaci: ti diamo tutte le informazioni e, se
                  vuoi, lo tratteniamo finché passi a vederlo.
                </p>
                <a class="bottone bottone--pieno" href={whatsappLink(oggetto.nome)}>
                  Scrivici su WhatsApp
                </a>
                <a class="contatto__telefono" href={`tel:${siteConfig.telefono}`}>
                  oppure chiama il {siteConfig.telefonoVisibile}
                </a>
              </div>
            ) : (
              <div class="contatto">
                <p class="contatto__titolo">Questo pezzo è stato venduto.</p>
                <p class="contatto__testo">
                  Se cerchi qualcosa di simile, scrivici: spesso arrivano
                  oggetti dello stesso genere.
                </p>
                <a class="bottone bottone--contorno" href={whatsappLink()}>
                  Scrivici su WhatsApp
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  /* Galleria: frecce e puntini, senza librerie. */
  const foto = Array.from(
    document.querySelectorAll<HTMLImageElement>(".galleria__foto")
  );
  const punti = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".galleria__punto")
  );
  let corrente = 0;

  function mostra(indice: number) {
    corrente = (indice + foto.length) % foto.length;
    foto.forEach((f, i) => (f.hidden = i !== corrente));
    punti.forEach((p, i) => p.classList.toggle("attivo", i === corrente));
  }

  document
    .querySelectorAll<HTMLButtonElement>(".galleria__freccia")
    .forEach((freccia) => {
      freccia.addEventListener("click", () =>
        mostra(corrente + Number(freccia.dataset.direzione))
      );
    });

  punti.forEach((punto) => {
    punto.addEventListener("click", () => mostra(Number(punto.dataset.vai)));
  });
</script>

<style>
  .briciole {
    margin-bottom: 1.8rem;
  }

  .briciole a {
    color: var(--grigio);
    text-decoration: none;
    font-size: 1rem;
  }

  .briciole a:hover {
    color: var(--inchiostro);
    text-decoration: underline;
  }

  .dettaglio {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* --- Galleria ----------------------------------------------------------- */

  .galleria__cornice {
    position: relative;
    background: var(--sfondo-scuro);
    border-radius: var(--raggio);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .galleria__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .galleria__freccia {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: none;
    background: rgba(252, 251, 249, 0.92);
    color: var(--inchiostro);
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background-color 0.2s ease;
  }

  .galleria__freccia:hover {
    background: var(--carta);
  }

  .galleria__freccia--sinistra {
    left: 0.9rem;
  }

  .galleria__freccia--destra {
    right: 0.9rem;
  }

  .galleria__punti {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }

  .galleria__punto {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    border: none;
    background: var(--linea);
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease;
  }

  .galleria__punto.attivo {
    background: var(--inchiostro);
  }

  /* --- Testo --------------------------------------------------------------- */

  .dettaglio__titolo {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .dettaglio__epoca {
    color: var(--grigio-chiaro);
    font-size: 1.1rem;
    margin-top: 0.3rem;
  }

  .dettaglio__prezzo {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--inchiostro);
    margin-top: 1rem;
  }

  .dettaglio__descrizione {
    margin-top: 1.5rem;
    color: var(--grigio);
    max-width: 58ch;
  }

  /* --- Caratteristiche ------------------------------------------------------ */

  .caratteristiche {
    margin: 2rem 0 0;
    border-top: 1px solid var(--linea);
  }

  .caratteristiche__voce {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--linea);
  }

  .caratteristiche dt {
    color: var(--grigio-chiaro);
    font-size: 1rem;
  }

  .caratteristiche dd {
    margin: 0;
    color: var(--inchiostro);
  }

  /* --- Box contatto --------------------------------------------------------- */

  .contatto {
    margin-top: 2.5rem;
    background: var(--carta);
    border: 1px solid var(--linea);
    border-radius: var(--raggio);
    padding: 1.8rem;
  }

  .contatto__titolo {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .contatto__testo {
    color: var(--grigio);
    margin-block: 0.6rem 1.4rem;
  }

  .contatto__telefono {
    display: block;
    margin-top: 1rem;
    color: var(--grigio);
    font-size: 1.0625rem;
  }

  @media (max-width: 900px) {
    .dettaglio {
      grid-template-columns: 1fr;
    }
  }
</style>
