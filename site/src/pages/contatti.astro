---
import Base from "../layouts/Base.astro";
import { siteConfig, whatsappLink } from "../config/site.config";
---

<Base
  titolo="Contatti"
  descrizione="Dove trovarci, orari di apertura e contatti di HD Design."
>
  <section class="sezione">
    <div class="contenitore">
      <h1 class="titolo-sezione">Vieni a trovarci</h1>
      <p class="sottotitolo-sezione">
        Il negozio è il posto migliore per vedere i pezzi dal vivo. Se
        preferisci, scrivici o chiamaci: rispondiamo volentieri.
      </p>

      <div class="colonne">
        <div class="scheda-info">
          <h2 class="scheda-info__titolo">Contatti</h2>
          <p class="scheda-info__voce">
            <span class="scheda-info__etichetta">Telefono</span>
            <a href={`tel:${siteConfig.telefono}`}>{siteConfig.telefonoVisibile}</a>
          </p>
          <p class="scheda-info__voce">
            <span class="scheda-info__etichetta">Indirizzo</span>
            {siteConfig.indirizzo}
          </p>
          {
            siteConfig.email && (
              <p class="scheda-info__voce">
                <span class="scheda-info__etichetta">Email</span>
                <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
              </p>
            )
          }
          <a class="bottone bottone--pieno scheda-info__bottone" href={whatsappLink()}>
            Scrivici su WhatsApp
          </a>
        </div>

        <div class="scheda-info">
          <h2 class="scheda-info__titolo">Orari di apertura</h2>
          <ul class="orari">
            {siteConfig.orari.map((riga) => <li>{riga}</li>)}
          </ul>
        </div>
      </div>

      <div class="mappa">
        {
          siteConfig.mappaEmbedUrl ? (
            <iframe
              src={siteConfig.mappaEmbedUrl}
              title={`Mappa: come raggiungere ${siteConfig.nomeAttivita}`}
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            />
          ) : (
            <div class="mappa__segnaposto">
              <p>
                La mappa comparirà qui: inserisci il link di incorporamento di
                Google Maps nel file di configurazione
                (<code>site.config.ts</code>, campo <code>mappaEmbedUrl</code>).
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .colonne {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .scheda-info {
    background: var(--carta);
    border: 1px solid var(--linea);
    border-radius: var(--raggio);
    padding: 2rem;
  }

  .scheda-info__titolo {
    font-size: 1.6rem;
    margin-bottom: 1.2rem;
  }

  .scheda-info__voce {
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .scheda-info__etichetta {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--grigio-chiaro);
    margin-bottom: 0.15rem;
  }

  .scheda-info__bottone {
    margin-top: 1.2rem;
  }

  .orari {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .orari li {
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--linea);
  }

  .orari li:last-child {
    border-bottom: none;
  }

  .mappa {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .mappa iframe {
    width: 100%;
    height: 420px;
    border: 1px solid var(--linea);
    border-radius: var(--raggio);
    display: block;
  }

  .mappa__segnaposto {
    background: var(--sfondo-scuro);
    border: 1px dashed var(--grigio-chiaro);
    border-radius: var(--raggio);
    padding: 3rem 2rem;
    text-align: center;
    color: var(--grigio);
  }

  @media (max-width: 720px) {
    .colonne {
      grid-template-columns: 1fr;
    }
  }
</style>
