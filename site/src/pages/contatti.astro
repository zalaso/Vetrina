---
import Base from "../layouts/Base.astro";
import {
  siteConfig,
  whatsappLink,
  compilato,
  orariCompilati,
} from "../config/site.config";

const mostraIndirizzo = compilato(siteConfig.indirizzo);
const orari = orariCompilati();

/**
 * La mappa: se non è stato indicato un link di incorporamento ma l'indirizzo
 * c'è, ne costruiamo uno da soli. Non serve nessuna chiave di Google.
 */
const mappaUrl = siteConfig.mappaEmbedUrl
  ? siteConfig.mappaEmbedUrl
  : mostraIndirizzo
    ? `https://www.google.com/maps?q=${encodeURIComponent(siteConfig.indirizzo)}&output=embed`
    : "";
---

<Base
  titolo="Contatti"
  descrizione={`Dove trovarci, orari di apertura e contatti di ${siteConfig.nomeAttivita}.`}
>
  <section class="sezione">
    <div class="contenitore">
      <h1 class="titolo-sezione">Vieni a trovarci</h1>
      <p class="sottotitolo-sezione">
        {
          mostraIndirizzo
            ? siteConfig.indirizzo
            : "Il posto migliore per vedere i pezzi è dal vivo. Chiamaci o scrivici: ti diciamo volentieri dove siamo e quando passare."
        }
      </p>

      <div class="colonne">
        <div class="scheda-info">
          <h2 class="scheda-info__titolo">Contatti</h2>
          <p class="scheda-info__voce">
            <span class="scheda-info__etichetta">Telefono</span>
            <a href={`tel:${siteConfig.telefono}`}>{siteConfig.telefonoVisibile}</a>
          </p>
          {
            mostraIndirizzo && (
              <p class="scheda-info__voce">
                <span class="scheda-info__etichetta">Indirizzo</span>
                {siteConfig.indirizzo}
              </p>
            )
          }
          {
            compilato(siteConfig.email) && (
              <p class="scheda-info__voce">
                <span class="scheda-info__etichetta">Email</span>
                <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
              </p>
            )
          }
          <a class="bottone bottone--pieno scheda-info__bottone" href={whatsappLink()}>
            Scrivici su WhatsApp
          </a>
        </div>

        {
          orari.length > 0 && (
            <div class="scheda-info">
              <h2 class="scheda-info__titolo">Orari di apertura</h2>
              <ul class="orari">
                {orari.map((riga) => (
                  <li>{riga}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      {
        mappaUrl && (
          <div class="mappa">
            <iframe
              src={mappaUrl}
              title={`Mappa: come raggiungere ${siteConfig.nomeAttivita}`}
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .colonne {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* Se c'è una sola scheda non deve occupare tutta la larghezza */
  .colonne:has(.scheda-info:only-child) {
    grid-template-columns: minmax(0, 28rem);
  }

  .scheda-info {
    background: var(--carta);
    border: 1px solid var(--linea);
    border-radius: var(--raggio);
    padding: 2rem;
  }

  .scheda-info__titolo {
    font-size: 1.6rem;
    margin-bottom: 1.2rem;
  }

  .scheda-info__voce {
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .scheda-info__etichetta {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--grigio-chiaro);
    margin-bottom: 0.15rem;
  }

  .scheda-info__bottone {
    margin-top: 1.2rem;
  }

  .orari {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .orari li {
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--linea);
  }

  .orari li:last-child {
    border-bottom: none;
  }

  .mappa {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .mappa iframe {
    width: 100%;
    height: 420px;
    border: 1px solid var(--linea);
    border-radius: var(--raggio);
    display: block;
  }

  @media (max-width: 720px) {
    .colonne {
      grid-template-columns: 1fr;
    }
  }
</style>
