# =============================================================================
#  Sito vetrina — variabili d'ambiente
# =============================================================================
#  Copia questo file in `.env` e compila i valori.
#  In produzione gli stessi valori vanno nelle Environment Variables del
#  progetto su Vercel.
#
#  Senza nessuna variabile il sito funziona lo stesso: mostra una bottega di
#  esempio con un catalogo finto. È il modo più rapido per vederlo girare.
# =============================================================================


# --- Catalogo ----------------------------------------------------------------
# Senza queste due il sito usa il catalogo di esempio in src/data/mock.ts.

# Personal Access Token di Airtable (scope: data.records:read)
AIRTABLE_API_KEY=

# ID della base Airtable (inizia con "app")
AIRTABLE_BASE_ID=


# --- Indirizzo pubblico ------------------------------------------------------
# Serve per sitemap, link canonici e anteprime di condivisione.
# Senza, si assume http://localhost:4321 (va bene solo in locale).
SITE_URL=


# --- Dati della bottega ------------------------------------------------------
# Impostare SHOP_NAME fa uscire il sito dalla modalità esempio: da quel
# momento i campi lasciati vuoti restano vuoti, invece di mostrare i dati
# della bottega di fantasia.

# Nome dell'attività, usato in titoli e intestazioni
SHOP_NAME=

# Recapiti: obbligatori quando SHOP_NAME è impostato.
# Senza, la compilazione si ferma invece di pubblicare contatti rotti.
SHOP_PHONE=              # formato internazionale, es. +393391234567
SHOP_PHONE_DISPLAY=      # come si legge a schermo, es. 339 123 4567
SHOP_WHATSAPP=           # come SHOP_PHONE ma senza "+", es. 393391234567

# Facoltativi: se vuoti spariscono dal sito senza lasciare buchi.
SHOP_TAGLINE=            # frase breve nel footer
SHOP_DESCRIPTION=        # descrizione per i motori di ricerca
SHOP_OWNER=              # nome e cognome del titolare
SHOP_LEGAL_NAME=         # ragione sociale nel footer
SHOP_VAT=                # partita IVA
SHOP_EMAIL=
SHOP_ADDRESS=            # via, numero civico, CAP, città

# Orari di apertura, righe separate da "|"
# es. Lunedì - Venerdì: 9:30 - 19:00|Sabato: 9:30 - 12:30|Domenica: chiuso
SHOP_HOURS=

# Marchio: di norma si ricava dal nome ("Bottega del Ponte" diventa "Bottega"
# grande con "del Ponte" spaziato sotto). Compilali per forzarlo.
SHOP_LOGO_MONOGRAM=
SHOP_LOGO_WORD=

# Mappa: di norma lasciala vuota, viene ricavata da SHOP_ADDRESS.
# Compilala solo per usare un link di incorporamento specifico di Google Maps.
SHOP_MAP_EMBED_URL=


# --- Pagina "La storia" ------------------------------------------------------
# Senza SHOP_STORY_PARAGRAPHS la pagina sparisce dal menu e resta fuori dai
# motori di ricerca: meglio nessuna pagina che una pagina vuota.

# Paragrafi della biografia, separati da "|"
SHOP_STORY_PARAGRAPHS=

SHOP_STORY_TITLE=        # titolo della pagina
SHOP_STORY_ROLE=         # qualifica sotto il nome, es. Antiquario
SHOP_STORY_PHOTO=        # percorso della foto, es. /titolare.jpg (in public/)
SHOP_STORY_QUOTE=        # una frase del titolare, mostrata in evidenza
