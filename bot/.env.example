# --- Bot Telegram -----------------------------------------------------------
# Copia questo file in `.env` e compila i valori.
# In produzione gli stessi valori vanno nelle Environment Variables del
# progetto su Vercel.

# Nome della bottega: compare nelle istruzioni date all'AI, così le
# descrizioni generate parlano del negozio giusto.
SHOP_NAME=

# Token del bot, ottenuto da @BotFather su Telegram
TELEGRAM_BOT_TOKEN=

# Chiave API Anthropic (console.anthropic.com) — per interpretare i messaggi
ANTHROPIC_API_KEY=

# Chiave API OpenAI (platform.openai.com) — solo per trascrivere i vocali (Whisper)
OPENAI_API_KEY=

# Personal Access Token di Airtable (scope: data.records:read + data.records:write)
AIRTABLE_API_KEY=

# ID della base Airtable (inizia con "app...")
AIRTABLE_BASE_ID=

# Credenziali Cloudinary (dashboard di cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Deploy hook di Vercel del SITO: rigenera il sito a ogni modifica del catalogo
VERCEL_DEPLOY_HOOK_URL=

# ID Telegram autorizzati, separati da virgola (es. "123456789,987654321").
# Chiunque altro riceve "Bot privato". Per scoprire il proprio ID: @userinfobot
ALLOWED_TELEGRAM_IDS=

# URL del webhook (serve solo per lo script "npm run set-webhook"),
# es. https://tuo-bot.vercel.app/api/webhook
WEBHOOK_URL=
